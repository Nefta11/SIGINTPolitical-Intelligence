# API Key de Anthropic (Claude)
# Obtén tu key en: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=sk-ant-TU-API-KEY-AQUI

# Modo de ejecución: "direct" (llamadas directas a API) o "proxy" (a través del backend)
VITE_API_MODE=direct

# Puerto del backend proxy (solo si usas modo proxy)
VITE_PROXY_PORT=3001
